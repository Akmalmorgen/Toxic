# ============================================================
# 𐌽ꤕ𐌗ተ — переменные окружения (ШАБЛОН)
# ============================================================
# ⚠️ НЕ кладите реальные значения сюда.
# Этот файл — только инструкция. Реальные секреты живут на хостинге.
# ============================================================

# --- ОБЯЗАТЕЛЬНЫЕ ---
# Токен бота от @BotFather. Формат: 123456789:ABCdefGHIjkl...
BOT_TOKEN=

# ID админов через запятую. Узнать: @userinfobot
# Пример: 123456789,987654321
ADMIN_IDS=

# --- РЕКОМЕНДУЕМЫЕ (для сохранения данных) ---
# Строка PostgreSQL (Neon). Если пусто — SQLite (bot.db).
# ⚠️ На Render без DATABASE_URL все данные удалятся при рестарте!
# Формат: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# --- ОПЦИОНАЛЬНЫЕ ---
DB_PATH=bot.db
PORT=8080
